[init]

[hub]
protocol = https
{{- /* machine = work: work identity is the default and personal repos are
       matched by URL; personal (default): the reverse. Signing is on only
       when the default identity has a signing key. */ -}}
{{- $work := eq (default "personal" (index . "machine")) "work" }}
{{- $email := .git_email }}
{{- $key := .git_signingkey }}
{{- $name := .git_name }}
{{- if $work }}
{{- $email = .work_git_email }}
{{- $key = .work_git_signingkey }}
{{- $name = .work_git_name }}
{{- end }}
[user]
	email = {{ $email | quote }}
	name = {{ $name | quote }}
{{- if $key }}
	signingkey = {{ $key | quote }}
{{- end }}
[color]
	ui = true
[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f
[fetch]
	prune = true
[commit]
	gpgsign = {{ if $key }}true{{ else }}false{{ end }}
[branch]
	sort=-committerdate
{{- if and (not $work) .work_git_signingkey }}

# Work repos identify differently. Matched on the remote URL so it applies
# wherever the clone lives, plus the working directory for clones that have no
# remote yet. Patterns and identity come from local chezmoi data - this repo is
# public. Two URL patterns because `*` does not cross `/`.
{{- range splitList "," .work_git_urlmatch }}
[includeIf "hasconfig:remote.*.url:{{ . }}"]
	path = ~/.gitconfig-work
{{- end }}
[includeIf "gitdir:{{ .work_git_dir }}"]
	path = ~/.gitconfig-work
{{- end }}
{{- if $work }}

# Personal repos on a work machine, matched on the remote URL.
{{- range splitList "," (default "git@github.com:dehora/*,https://github.com/dehora/*" (index . "personal_git_urlmatch")) }}
[includeIf "hasconfig:remote.*.url:{{ . }}"]
	path = ~/.gitconfig-personal
{{- end }}
{{- end }}
