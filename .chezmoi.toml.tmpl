{{- $machine := promptStringOnce . "machine" "Machine type (personal or work)" "personal" -}}
{{- $git_email := promptStringOnce . "git_email" "Personal git email" -}}
{{- $git_name := promptStringOnce . "git_name" "Personal git name" -}}
{{- $git_signingkey := promptStringOnce . "git_signingkey" "Personal git signing key (blank if none)" "" -}}
{{- /* Work identity. Prompts are generic; the values stay in the local config. */ -}}
{{- $work_git_email := promptStringOnce . "work_git_email" "Work git email (blank if none)" "" -}}
{{- $work_git_name := promptStringOnce . "work_git_name" "Work git name" -}}
{{- if and $work_git_email (not $work_git_name) }}{{ fail "Work git name is required when a work git email is set" }}{{ end -}}
{{- $work_git_signingkey := promptStringOnce . "work_git_signingkey" "Work git signing key (blank if none)" "" -}}
{{- $work_git_urlmatch := promptStringOnce . "work_git_urlmatch" "Work remote-URL globs for personal machines, comma separated (blank if none)" "" -}}
{{- $work_git_dir := promptStringOnce . "work_git_dir" "Work checkout dir for personal machines, trailing slash (blank if none)" "" -}}
{{- $personal_git_urlmatch := promptStringOnce . "personal_git_urlmatch" "Personal remote-URL globs for work machines, comma separated" "git@github.com:dehora/*,https://github.com/dehora/*" -}}
{{- $emacs_name := promptStringOnce . "emacs_name" "Emacs name" -}}
{{- $emacs_email := promptStringOnce . "emacs_email" "Emacs email" -}}
{{- $todoist_api_token := promptStringOnce . "todoist_api_token" "Todoist API token" -}}
{{- $anthropic_api_key := promptStringOnce . "anthropic_api_key" "Anthropic API key (blank if none)" "" -}}
{{- $roborev_default_agent := promptStringOnce . "roborev_default_agent" "RoboRev default agent" "codex" -}}
{{- $roborev_design_agent := promptStringOnce . "roborev_design_agent" "RoboRev design agent (optional)" "" -}}
{{- $roborev_fix_agent := promptStringOnce . "roborev_fix_agent" "RoboRev fix agent (optional)" "" -}}
{{- $roborev_review_agent := promptStringOnce . "roborev_review_agent" "RoboRev review agent (optional)" "" -}}

[data]
    machine = {{ $machine | quote }}
    git_email = {{ $git_email | quote }}
    git_name = {{ $git_name | quote }}
    git_signingkey = {{ $git_signingkey | quote }}
    work_git_email = {{ $work_git_email | quote }}
    work_git_name = {{ $work_git_name | quote }}
    work_git_signingkey = {{ $work_git_signingkey | quote }}
    work_git_urlmatch = {{ $work_git_urlmatch | quote }}
    work_git_dir = {{ $work_git_dir | quote }}
    personal_git_urlmatch = {{ $personal_git_urlmatch | quote }}
    emacs_name = {{ $emacs_name | quote }}
    emacs_email = {{ $emacs_email | quote }}
    todoist_api_token = {{ $todoist_api_token | quote }}
    anthropic_api_key = {{ $anthropic_api_key | quote }}
    roborev_default_agent = {{ $roborev_default_agent | quote }}
    roborev_design_agent = {{ $roborev_design_agent | quote }}
    roborev_fix_agent = {{ $roborev_fix_agent | quote }}
    roborev_review_agent = {{ $roborev_review_agent | quote }}
