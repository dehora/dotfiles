(setq org-refile-allow-creating-parent-nodes 'confirm)
(setq org-refile-use-outline-path 'file)

;;
;; org agenda conf
;;
(define-key global-map "\C-ca" 'org-agenda)

;;
;; C-c 1: every open #1 in work.org, whatever week it's in
;;
(setq org-agenda-custom-commands
      `(("1" "Work #1s" tags-todo "+PRIORITY=\"1\""
         ((org-agenda-files (list ,dehora/work-file))))))
(defun dehora/work-ones ()
  (interactive)
  (org-agenda nil "1"))
(global-set-key (kbd "C-c 1") #'dehora/work-ones)

;;
;; M-x dehora/archive-work-year: move a year's week headings (and any
;; "* YEAR" block) from work.org into work.org_archive under "* YEAR",
;; matching the archive's year -> week layout
;;
(defun dehora/--cut (beg end)
  (prog1 (let ((s (buffer-substring beg end)))
           (if (string-suffix-p "\n" s) s (concat s "\n")))
    (delete-region beg end)))

(defun dehora/archive-work-year (year)
  (interactive
   (list (read-string "Archive year: "
                      (number-to-string (1- (decoded-time-year (decode-time)))))))
  (let* ((archive (concat dehora/work-file "_archive"))
         (week-re (concat "^\\* " (regexp-quote year) "-W[0-9]+"))
         (year-re (concat "^\\* " (regexp-quote year) "[ \t]*$"))
         (weeks '()) (wrapped "") (n 0))
    (with-current-buffer (find-file-noselect dehora/work-file)
      (org-with-wide-buffer
       (goto-char (point-min))
       (while (re-search-forward "^\\* " nil t)
         (beginning-of-line)
         (when (or (looking-at week-re) (looking-at year-re)) (cl-incf n))
         (end-of-line))
       (when (zerop n) (user-error "Nothing for %s in work.org" year))
       (unless (yes-or-no-p (format "Move %d heading(s) for %s to the archive? " n year))
         (user-error "Cancelled"))
       (goto-char (point-max))
       (while (re-search-backward "^\\* " nil t)
         (let ((end (save-excursion (org-end-of-subtree t t) (point))))
           (cond ((looking-at week-re) (push (dehora/--cut (point) end) weeks))
                 ((looking-at year-re)
                  (setq wrapped (dehora/--cut (line-beginning-position 2) end))
                  (delete-region (point) (line-beginning-position 2))))))
       (save-buffer)))
    (let ((body (concat (with-temp-buffer
                          (insert (apply #'concat weeks))
                          (delay-mode-hooks (org-mode))
                          (org-map-entries #'org-demote)
                          (buffer-string))
                        wrapped)))
      (with-current-buffer (find-file-noselect archive)
        (org-with-wide-buffer
         (goto-char (point-min))
         (if (re-search-forward year-re nil t)
             (forward-line 1)
           (goto-char (point-min))
           (if (re-search-forward "^\\* " nil t)
               (beginning-of-line)
             (goto-char (point-max)))
           (insert "* " year "\n"))
         (insert body))
        (save-buffer)))
    (message "Archived %d heading(s) for %s" n year)))

;;
;; org logging: just a CLOSED timestamp when something is done; the only
;; logbook entry is the reason asked for when an item goes to NOPE
;;
(setq org-log-done 'time)

