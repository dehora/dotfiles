;;
;; org-capture conf
;;
(global-set-key (kbd "C-c c") 'org-capture)

;;
;; work.org is a weekly log: top-level headings are ISO weeks (2026-W46),
;; newest first. Capture files into this week's heading, creating it at the
;; top of the file when it doesn't exist yet.
;;
(defconst dehora/work-file
  "~/Library/Mobile Documents/iCloud~com~appsonthemove~beorg/Documents/org/work.org")

(defun dehora/goto-work-week ()
  "Put point on this week's top-level heading, creating it if missing."
  (let ((heading (format-time-string "%G-W%V")))
    (widen)
    (goto-char (point-min))
    (unless (re-search-forward
             (concat "^\\* " (regexp-quote heading) "[ \t]*$") nil t)
      (goto-char (point-min))
      (if (re-search-forward "^\\* " nil t)
          (beginning-of-line)
        (goto-char (point-max))
        (unless (bolp) (insert "\n")))
      (insert "* " heading "\n")
      (forward-line -1))
    (beginning-of-line)))

(setq org-capture-templates `(("w" "work task" entry
                               (file+function ,dehora/work-file dehora/goto-work-week)
                               "* TODO %i%?")
                              ("n" "work note" entry
                               (file+function ,dehora/work-file dehora/goto-work-week)
                               "* %?\n%U")
                              ("d" "dehora" entry
                               (file+headline "~/Library/Mobile Documents/iCloud~com~appsonthemove~beorg/Documents/org/dehora.org" "Inbox")
                               "* TODO %i%? \n %U")))

;;
;; shortcuts: C-c t = work task, C-c n = work note (same as C-c c w / C-c c n)
;;
(defun dehora/capture-work-task () (interactive) (org-capture nil "w"))
(defun dehora/capture-work-note () (interactive) (org-capture nil "n"))
(global-set-key (kbd "C-c t") #'dehora/capture-work-task)
(global-set-key (kbd "C-c n") #'dehora/capture-work-note)

;;
;; allow refile to target a file and then optionally create an new entry
