# Included by ~/.gitconfig on a work machine for repos whose remote matches
# the personal pattern. Values come from local chezmoi data, never this repo.
[user]
	email = {{ .git_email | quote }}
{{- if .git_signingkey }}
	signingkey = {{ .git_signingkey | quote }}
[commit]
	gpgsign = true
{{- else }}
[commit]
	gpgsign = false
{{- end }}
